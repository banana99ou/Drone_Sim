build/
install/
log/
logs/*.csv
__pycache__/
*.pyc
logs/*.svg
web/current.json
logs/.sim.pid
logs/sim.log
# The viewer is a launch of its own now (see viz.launch.py), with its own
# host-side pid file and its own log.
logs/.viz.pid
logs/viz.log
docker/ca/*.crt
# Solved plans are outputs: `make solve` and the viewer's solve button both
# overwrite them, so tracking one means every solve dirties the tree. The
# *_seed.json plans are NOT outputs -- they are generated by gen_assets.py
# from the scenario and checked by `gen_assets.py --check`, so they stay.
plans/*.json
!plans/*_seed.json
plans/*.json.tmp
