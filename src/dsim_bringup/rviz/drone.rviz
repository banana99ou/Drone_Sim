Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: world
    - Class: rviz_default_plugins/Odometry
      Name: Drone pose
      Enabled: true
      Topic:
        Value: /drone/truth
        Depth: 50
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Keep: 200
      Shape:
        Value: Arrow
        Color: 255; 85; 0
        Alpha: 0.8
        Shaft Length: 0.2
        Shaft Radius: 0.03
        Head Length: 0.1
        Head Radius: 0.06
      Covariance:
        Value: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point: {X: 0, Y: 0, Z: 1}
      Pitch: 0.5
      Yaw: 0.8
      Name: Current View
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
  Displays: {collapsed: false}
