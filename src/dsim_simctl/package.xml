<?xml version="1.0"?>
<package format="3">
  <name>dsim_simctl</name>
  <version>0.1.0</version>
  <description>
    The only write path into the simulator: pause, playback speed and reset,
    driven by stepping the world rather than by editing its physics profile.
  </description>
  <maintainer email="banana99ou@gmail.com">JHY</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>dsim_msgs</depend>
  <depend>dsim_time</depend>
  <depend>gz_msgs_vendor</depend>
  <depend>gz_transport_vendor</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
