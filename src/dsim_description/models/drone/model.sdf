                       \  +x  /
                        [body]
                       /      \
         rotor_3 (cw, BL)      rotor_1 (ccw, BR)
-->
<sdf version="1.9">
  <model name="drone">
    <pose>0 0 0.1 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>1.48</mass>
        <inertia>
          <ixx>0.015</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.015</iyy><iyz>0</iyz><izz>0.025</izz>
