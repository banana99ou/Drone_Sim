                <dynamic_bias_stddev>1e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.044</stddev>
                <bias_mean>0.02</bias_mean>
                <bias_stddev>0.005</bias_stddev>
                <dynamic_bias_stddev>0.001</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.044</stddev>
                <bias_mean>0.02</bias_mean>
                <bias_stddev>0.005</bias_stddev>
                <dynamic_bias_stddev>0.001</dynamic_bias_stddev>
