# Machine-specific settings for the Makefile. Copy to .env.local (gitignored)
# and fill in. Make syntax: NAME = value, no quotes, no `export`.
#
# Only `make planner-sync` needs any of this. Building, testing and flying the
# simulator work without it.

# Where the space-time planner's worktree lives, as rsync/ssh would address it.
# On a tailnet with MagicDNS that is <user>@<machine>.<tailnet>.ts.net.
PLANNER_HOST = you@your-machine.your-tailnet.ts.net

# Path to the worktree ON THAT HOST, relative to its home directory.
PLANNER_PATH = code/bezier-trajectory-merge

# Where the synced copy lands on THIS machine. The container mounts it at
# /ws/planner_src.
# PLANNER_REPO = $(HOME)/code/bezier-trajectory-merge-sync
